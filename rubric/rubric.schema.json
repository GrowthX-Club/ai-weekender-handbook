{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://growthx.club/schemas/ai-immersion-rubric.schema.json",
  "title": "AI Immersion rubric contract",
  "type": "object",
  "required": ["program", "version", "score_formula", "tracks", "evidence_rules", "anti_spoof", "bonus"],
  "properties": {
    "program": { "const": "AI Immersion" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "score_formula": { "const": "(level - 1) * weight" },
    "tracks": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "stored_enum", "public_name", "base_max", "parameters"],
        "properties": {
          "id": { "type": "string" },
          "stored_enum": { "enum": ["virality", "revenue", "maas"] },
          "public_name": { "type": "string" },
          "base_max": { "type": "number", "minimum": 0 },
          "parameters": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "public_name", "weight", "base_max", "levels", "overflow"],
              "properties": {
                "id": { "type": "string" },
                "public_name": { "type": "string" },
                "weight": { "type": "number", "exclusiveMinimum": 0 },
                "base_max": { "type": "number", "minimum": 0 },
                "levels": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "type": "string" } },
                "overflow": { "type": ["object", "null"] }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "evidence_rules": { "type": "object" },
    "anti_spoof": { "type": "array", "minItems": 2, "maxItems": 2 },
    "bonus": { "type": "object" }
  },
  "additionalProperties": true
}
